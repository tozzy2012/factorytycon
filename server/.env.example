# ═══ Industrial Pipeline — Variáveis de Ambiente ═══
# Copie para .env e preencha os valores reais antes de subir em produção.

NODE_ENV=production
PORT=3001

# Banco de dados (SQLite)
DB_PATH=/jogo/server/data/game.db

# JWT — OBRIGATÓRIO em produção: gere com: openssl rand -base64 48
JWT_SECRET=

# Tempo de vida dos tokens
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Segurança
BCRYPT_ROUNDS=12

# CORS — domínio(s) do frontend, separados por vírgula
CORS_ORIGIN=http://localhost

# NOTA: O servidor escuta em 127.0.0.1 (loopback) por design.
# Configure seu reverse proxy (Nginx) para fazer proxy_pass para localhost:3001.
